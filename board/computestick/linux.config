# ============================================================
#  Linux Kernel Config Fragment
#  Intel Atom Z3735F (Bay Trail) — STCK1A32WFC
# ============================================================

# --- EFI & Boot ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=y
CONFIG_EFI_VARS=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_CMDLINE_BOOL=y

# --- ACPI (needed for Bay Trail hardware enumeration) ---
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_THERMAL=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_INTEL_IDLE=y
CONFIG_X86_INTEL_LPSS=y

# --- eMMC Storage (Bay Trail uses ACPI-enumerated SDHCI) ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_MMC_SDHCI_IO_ACCESSORS=y

# --- Intel GPU / HDMI (i915) ---
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_I915_ALPHA_SUPPORT=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_AGP=y
CONFIG_AGP_INTEL=y

# --- USB ---
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_COMMON=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y

# --- USB Serial (3D Printer boards) ---
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CH341=y       # CH340/CH341 — Creality, Ender, most budget boards
CONFIG_USB_SERIAL_CP210X=y      # CP2102 — used on some printer boards
CONFIG_USB_SERIAL_FTDI_SIO=y    # FTDI — used on original RepRap/Prusa boards
CONFIG_USB_ACM=y                # CDC ACM — used by some printer firmware

# --- WiFi — RTL8723BS (SDIO Realtek, the Compute Stick's WiFi chip) ---
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_RFKILL=y
CONFIG_RTL8723BS=m              # RTL8723BS SDIO driver (Bay Trail Compute Stick)
CONFIG_RTL8XXXU=m               # Backup Realtek driver
CONFIG_REALTEK_PHY=y

# --- Networking ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_MASQ=y

# --- Thermal ---
CONFIG_THERMAL=y
CONFIG_INTEL_POWERCLAMP=y
CONFIG_X86_PKG_TEMP_THERMAL=y
CONFIG_INTEL_SOC_DTS_THERMAL=y

# --- Power Management ---
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y
CONFIG_PM_AUTOSLEEP=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_INTEL_CPUFREQ=y

# --- Filesystems ---
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Misc ---
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_DMIID=y
CONFIG_DMI_SCAN_MACHINE_NON_EFI_FALLBACK=y
CONFIG_RANDOM_TRUST_CPU=y
